# 应用配置文件路径（models / mcpServers / clusters）
AIOP_CONFIG=./config.jsonc

# 日志级别: trace|debug|info|warn|error
LOG_LEVEL=info

# ── HTTP + SSE 服务（tsx src/index.ts serve）──
HOST=0.0.0.0
PORT=8080

# ── 沙箱连接设置（由设置页保存到数据库；运行时从数据库读取）──
# 标准 E2B 使用 E2B_API_KEY。AIOS Lifecycle 的连接地址、placement 和 key 均在设置页维护，
# 不再通过 AIOS_SANDBOX_KEY 或 config.jsonc 在进程启动时注入。
E2B_API_KEY=

# ── 认证与设置加密（生产务必设置强随机值）──
# 会话 JWT 签名密钥（HS256）
AIOP_JWT_SECRET=
# 加密数据库中保存的设置敏感字段（例如沙箱 API key）；不得与 JWT 密钥复用。
AIOP_SETTINGS_SECRET=

# ── MySQL（S5 起用；连接走环境变量，密码 base64）──
MYSQL_HOST=mysql.db.internal
MYSQL_PORT=3306
MYSQL_DATABASE=ai_ops
MYSQL_USER=ai_ops
# echo -n 'your-password' | base64
MYSQL_PASSWORD_BASE64=
MYSQL_SSL=false
MYSQL_POOL_SIZE=10
