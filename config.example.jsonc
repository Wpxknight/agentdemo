{
  // 自定义模型服务：支持 anthropic / openai 协议，自定义 baseURL / apiKey
  "models": {
    "my-claude": {
      "protocol": "anthropic",
      "baseURL": "https://api.anthropic.com",
      "apiKey": "${ANTHROPIC_API_KEY}",
      "model": "claude-opus-4-8",
      // 推理深度：none 关闭思考；low|medium|high|xhigh|max 对应 Anthropic effort。
      // 缺省=思考开启走模型默认深度。也可在设置页调整。仅 anthropic 协议生效。
      "effort": "medium"
    },
    "my-gpt": {
      "protocol": "openai",
      "baseURL": "https://api.openai.com/v1",
      "apiKey": "${OPENAI_API_KEY}",
      "model": "gpt-4o"
    },
    "local": {
      "protocol": "openai",
      "baseURL": "http://localhost:8000/v1",
      "apiKey": "x",
      "model": "qwen"
    }
  },
  "defaultModel": "my-claude",
  // 工具权限规则（叠加在运维策略之上，覆盖所有工具）。语法：`工具名` 或 `工具名(子模式)`。
  // deny > ask > allow；deny 且不带子模式的工具在发给模型前即被剥离。
  // 子模式对 kubectl 是 `<verb>` / `<verb>:<资源名>`，对 sbx__run_command 是命令文本（shell 通配 * ?）。
  // "permissions": {
  //   "deny": ["kubectl(delete:*)", "sbx__run_command(*rm -rf /*)"],
  //   "ask": ["kubectl(drain:*)", "mcp__github*"],
  //   "allow": ["kubectl(get:*)", "kubectl(logs:*)"]
  // },
  // PreToolUse 钩子：工具执行前调外部处理器（可拒绝）。command 用退出码非 0 / stdout 含 "deny" 表示拒绝；
  // webhook POST JSON，响应 {"decision":"deny","reason":"..."} 或非 2xx 表示拒绝。webhook 默认禁止打私网(SSRF)。
  // "hooks": {
  //   "preToolUse": [
  //     { "type": "command", "command": "/opt/aiop/hooks/audit.sh", "tools": ["kubectl", "sbx__run_command"] },
  //     { "type": "webhook", "url": "https://approval.example.com/aiop/pretool", "tools": ["kubectl(delete:*)"] }
  //   ]
  //   // "allowPrivateWebhook": true  // 仅内网自建审批系统时开启
  // },
  // web_fetch 工具：抓网页查文档。默认启用；allowedDomains 限制可访问域名（含子域）；默认禁止打私网。
  // "webFetch": {
  //   "enabled": true,
  //   "allowedDomains": ["kubernetes.io", "docs.example.com"]
  //   // "allowPrivate": true  // 仅内网文档站点时开启
  // },
  // 技能目录。summaryBudget：技能摘要注入 system prompt 的字符预算（默认 4000）。
  // sandboxEnv：把稳定环境信息（如平台地址）注入会话沙箱环境变量；凭据类键（PASSWORD/TOKEN/SECRET 等）会被 schema 拒绝。
  "skills": {
    "dir": "./skills"
    // "summaryBudget": 4000,
    // "sandboxEnv": { "AIOS_BASE_URL": "http://10.10.72.20:30001/paas-web", "AIOS_CLIENT_ID": "..." }
  },
  // 认证：local（默认，用户名口令）或 oidc（SSO）。HTTP 服务接入后生效
  "auth": {
    "provider": "local"
    // "provider": "oidc",
    // "jwtTtl": "12h",
    // "oidc": {
    //   "issuer": "https://keycloak.example.com/realms/aiop",
    //   "clientId": "aiop",
    //   "clientSecret": "${OIDC_CLIENT_SECRET}",
    //   "redirectUri": "https://aiop.example.com/auth/callback",
    //   "scopes": ["openid", "profile", "email"],
    //   "mapping": {
    //     "tenantClaim": "tenant", "defaultTenant": "default",
    //     "usernameClaim": "preferred_username",
    //     "roleClaim": "groups",
    //     "roleMap": { "aiop-platform": "platform_admin", "aiop-admins": "tenant_admin" },
    //     "defaultRole": "user"
    //   }
    // }
  },
  // 沙箱：enabled=true 时注册代码/命令工具；desktop=true 时注册浏览器工具。
  // 本地开发可用 provider=local；生产 k8s 部署建议使用 opensandbox。
  "sandbox": {
    "enabled": false,
    // 后端：local（本机临时目录 + Chrome）、e2b（默认）或 opensandbox（阿里开源，k8s 运行时）
    "provider": "local",
    "apiKey": "${E2B_API_KEY}",
    "idleMs": 600000,
    "timeoutMs": 3600000,
    "desktop": true,         // local 使用本机 Chrome；e2b 使用 @e2b/desktop；opensandbox 在同一会话 Pod 内启动 Chrome
    "warmPoolSize": 0        // >0 预热沙箱（仅未配置 clusters 时生效）
    // —— OpenSandbox 后端示例（部署见 deploy/opensandbox/README.md）——
    // "provider": "opensandbox",
    // "domain": "opensandbox-server.opensandbox-system.svc:80", // Lifecycle API（host[:port]，无 scheme）
    // "protocol": "http",
    // "apiKey": "",            // 对应 server config.toml 的 api_key
    // "desktop": true,
    // "defaultImage": "aiop/opensandbox-browser:latest" // 需包含 node + chromium/python
  },
  // MCP server：stdio / sse / http 三种 transport，工具以 mcp__<server>__<tool> 暴露
  "mcpServers": {
    "local": {
      "transport": "stdio",
      "command": "node",
      "args": ["--import", "tsx", "scripts/mcp-echo-server.ts"]
    },
    "filesystem": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
    }
    // "remote": { "transport": "http", "url": "https://mcp.example.com/mcp", "headers": { "Authorization": "Bearer ${MCP_TOKEN}" } }
  },
  // 多集群运维：kubectl 在各集群 in-cluster 沙箱内执行；access=ro 拦截变更，production 变更需审批
  "clusters": {
    "dev": {
      "e2bControl": "https://e2b.dev-cluster.internal",
      "template": "kubectl-incluster",
      "namespace": "aiop",
      "serviceAccount": "aiop-ops",
      "access": "rw",
      "production": false,
      // 命名空间白名单：设置后只允许 -n 指定其中之一，禁止 --all-namespaces
      "allowNamespaces": ["aiop", "default"]
    },
    "prod": {
      "e2bControl": "https://e2b.prod-cluster.internal",
      "template": "kubectl-incluster",
      "namespace": "aiop",
      "serviceAccount": "aiop-readonly",
      "access": "ro",
      "production": true
    }
  }
}
