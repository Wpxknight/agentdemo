{
  "name": "aiop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "scheduler": "tsx src/index.ts scheduler",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'dist/**'",
    "test:watch": "vitest",
    "verify:node": "tsx scripts/verify-node.ts",
    "test:agent-platform": "vitest run tests/pi-*.test.ts tests/*runtime-store*.test.ts tests/durable-runtime.test.ts"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.9",
    "@anthropic-ai/sdk": "^0.104.2",
    "@e2b/code-interpreter": "^2.6.0",
    "@e2b/desktop": "^2.3.1",
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cron-parser": "^5.5.0",
    "jose": "^6.2.3",
    "kysely": "^0.29.2",
    "mysql2": "^3.22.5",
    "openai": "^6.43.0",
    "openid-client": "^6.8.4",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
